use flake . --impure

# A secondary jj workspace has no .env of its own (it is gitignored), so it
# borrows the main checkout's secrets. A local .env still wins when present.
if [[ ! -f .env && -f .jj/repo ]]; then
  repo="$(cat .jj/repo)"
  [[ "$repo" = /* ]] || repo=".jj/$repo"
  main_env="$(dirname "$(dirname "$repo")")/.env"
  watch_file "$main_env"
  dotenv_if_exists "$main_env"
else
  dotenv_if_exists
fi
